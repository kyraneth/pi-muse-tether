{
  "name": "pi-muse-tether",
  "version": "0.1.0",
  "type": "module",
  "description": "Use your Muse Code subscription in Pi through the official client",
  "license": "MIT",
  "keywords": ["pi-package", "pi", "muse", "tether"],
  "repository": {"type": "git", "url": "https://github.com/kyraneth/pi-muse-tether.git"},
  "homepage": "https://github.com/kyraneth/pi-muse-tether#readme",
  "bugs": {"url": "https://github.com/kyraneth/pi-muse-tether/issues"},
  "engines": {"node": ">=24"},
  "files": ["index.ts", "src/", "README.md", "LICENSE", "assets/", "docs/DETAILS.md"],
  "dependencies": {
    "@muse-code/sdk": "1.4.14",
    "pi-tether-core": "0.1.0"
  },
  "main": "index.ts",
  "pi": {
    "extensions": [
      "index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "typebox": "1.3.27",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "vitest": "^5.1.0",
    "tsx": "^4",
    "typescript": "^5"
  },
  "scripts": {
    "test": "vitest run tests --exclude tests/host.test.ts && node --import tsx --test tests/host.test.ts tests/catalog-entry.node.ts",
    "dev:install-core": "node scripts/install-core-main.mjs",
    "scan:public": "node scripts/check-public-tree.mjs",
    "export:manifest": "node scripts/export-manifest"
  }
}
